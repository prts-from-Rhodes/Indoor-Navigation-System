#!/bin/sh
#
# pre-commit 守卫：阻止 Unity 生成目录 / 本地配置被误提交
#
# 已跟踪文件不受 .gitignore 约束，且 --no-verify 之外还可能有人手滑
# 用 git add -f 强加。这个钩子做最后一道兜底。
#
# 启用方式（克隆后每人执行一次）：
#   git config core.hooksPath .githooks
#

DENY='(^|/)(Library|UserSettings|MemoryCaptures|Recordings|Temp|obj|Logs)/|(^|/)\.plastic/'

# --diff-filter=ACMR：只看新增/修改/改名/复制，删除（D）不拦截
bad=$(git diff --cached --name-only --diff-filter=ACMR -z \
      | tr '\0' '\n' \
      | grep -Ei "$DENY")

if [ -n "$bad" ]; then
  echo "" >&2
  echo "==============================================" >&2
  echo " ✗ 提交被拦截" >&2
  echo "==============================================" >&2
  echo " 以下路径是引擎/IDE 生成物或本地私有配置，" >&2
  echo " 不应进入版本库：" >&2
  echo "" >&2
  printf '%s\n' "$bad" | sed 's/^/     /' >&2
  echo "" >&2
  echo " 处理办法：" >&2
  echo "   git restore --staged <路径>     # 取消暂存" >&2
  echo "   git rm -r --cached <路径>       # 若已被跟踪，移出索引" >&2
  echo "" >&2
  echo " 确实要提交（不推荐）：git commit --no-verify" >&2
  echo "==============================================" >&2
  exit 1
fi

exit 0
